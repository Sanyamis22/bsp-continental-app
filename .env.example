# Copy to .env.local and fill in. Never commit real values.
# The app fails closed: routes that need a variable return a generic 500 until it is set.

# --- Database ---
MONGODB_URI=

# --- Auth.js (user login) ---
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 48   (also keys the OTP HMAC)
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admin login (separate signed JWT) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
# openssl rand -base64 48   (minimum 32 characters, else admin login/verification refuses to run)
JWT_SECRET=

# --- Email (welcome / terms mail; skipped if unset) ---
EMAIL_USER=
EMAIL_PASS=

# --- WhatsApp OTP gateway (Resiliohub) ---
RESILIO_API_TOKEN=

# --- AWS S3 uploads ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI chat (Groq) ---
GROQ_API_KEY=

# --- PAN verification sandbox ---
SANDBOX_API_KEY=
SANDBOX_API_SECRET=

# --- Parked features (no UI yet). Leave unset to keep the endpoints disabled ---
# FEATURE_CHAT=true
# FEATURE_CIBIL=true
